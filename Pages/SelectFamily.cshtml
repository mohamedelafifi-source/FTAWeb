@page
@model SelectFamilyModel
@{
    ViewData["Title"] = "Select Family";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="text-center mb-0">Update an Existing Family</h2>
                </div>
                <div class="card-body">
                    @if (Model.ShowPasswordForm)
                    {
                        <form method="post">
                            <div class="mb-3">
                                <label for="AccessPassword" class="form-label">Password</label>
                                <input type="password" class="form-control" name="AccessPassword" id="AccessPassword" placeholder="Enter password" autocomplete="current-password" autofocus />
                                @if (!string.IsNullOrEmpty(Model.PasswordError))
                                {
                                    <div class="text-danger small mt-1">@Model.PasswordError</div>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Continue</button>
                                <a asp-page="/Index" class="btn btn-secondary">Back</a>
                            </div>
                        </form>
                    }
                    else
                    {
                        @if (Model.Families.Count == 0)
                        {
                            <p class="text-muted mb-3">No families use this password.</p>
                        }
                        else
                        {
                            <p class="mb-3">Select a family to manage its Tree files.</p>
                            <div class="list-group">
                                @foreach (var family in Model.Families)
                                {
                                    <a asp-page="/FamilyDetail" asp-route-familyName="@family" class="list-group-item list-group-item-action">@family</a>
                                }
                            </div>
                        }
                        <div class="mt-3">
                            <a asp-page="/SelectFamily" class="btn btn-outline-secondary btn-sm">Select another Family</a>
                            <a asp-page="/Index" class="btn btn-secondary">Back</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
